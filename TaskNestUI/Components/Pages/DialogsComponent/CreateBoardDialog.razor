<EditForm Model="model" OnValidSubmit="@Submit">

    <RadzenFieldset Style="padding:16px;">
        <h4>Create board</h4>

        <div class="mb-3">
            <label class="form-label">Name</label>

            <RadzenTextBox @bind-Value="model.Name" Placeholder="Name" Style="width:100%" />

            @if (showNameError)
            {
                <div class="text-danger">Name is required.</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <RadzenTextBox @bind-Value="model.Description" Placeholder="Name" Style="width:100%" />
        </div>

        <div class="d-flex justify-content-end">

            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" Style="margin-right:8px;" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Create" />
        </div>
    </RadzenFieldset>
</EditForm>