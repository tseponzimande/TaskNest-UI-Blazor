<EditForm Model="column" OnValidSubmit="@Submit">
    <RadzenFieldset Style="padding:16px;">
        <h4>Create Column</h4>

        <div class="mb-3">
            <label class="form-label">Column Name</label>
            <RadzenTextBox @bind-Value="column.Name" Placeholder="e.g., To Do, In Progress, Done" Style="width:100%" />
            @if (showNameError)
            {
                <div class="text-danger">Column name is required.</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Order</label>
            <RadzenNumeric @bind-Value="column.Order" Min="0" Style="width:100%" />
            <small class="text-muted">Position of the column (0 = first)</small>
        </div>

        <div class="d-flex justify-content-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" Style="margin-right:8px;" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Create" Icon="add" />
        </div>
    </RadzenFieldset>
</EditForm>