<RadzenTabs Style="height:600px;">
    <Tabs>
        <!-- Details Tab -->
        <RadzenTabsItem Text="Details">
            <RadzenFieldset Style="padding:16px;">
                @if (isEditing)
                {
                    <EditForm Model="editModel" OnValidSubmit="@SaveChanges">
                        <h4>Edit Task</h4>

                        <div class="mb-3">
                            <label class="form-label">Task Title *</label>
                            <RadzenTextBox @bind-Value="editModel.Title" Placeholder="Enter task title" Style="width:100%" />
                            @if (showTitleError)
                            {
                                <div class="text-danger">Task title is required.</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <RadzenTextArea @bind-Value="editModel.Description" Placeholder="Enter task description"
                                            Rows="4" Style="width:100%" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Column</label>
                            <RadzenDropDown @bind-Value="editModel.ColumnId" Data="@Columns"
                                            TextProperty="Name" ValueProperty="Id"
                                            Style="width:100%" Placeholder="Select column" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Due Date</label>
                            <RadzenDatePicker @bind-Value="editModel.DueDate" Style="width:100%" ShowTime="false"
                                              DateFormat="MM/dd/yyyy" Placeholder="Select due date" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <RadzenButton Text="Delete Task" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                          Click="@ConfirmDelete" Style="margin-right:auto;" />
                            <div>
                                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@CancelEdit" Style="margin-right:8px;" />
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" />
                            </div>
                        </div>
                    </EditForm>
                }
                else
                {
                    <h4>@Task?.Title</h4>

                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p>@(string.IsNullOrEmpty(Task?.Description) ? "No description" : Task.Description)</p>
                    </div>

                    <div class="mb-3">
                        <strong>Created:</strong>
                        <p>@Task?.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>

                    @if (Task?.DueDate.HasValue == true)
                    {
                        <div class="mb-3">
                            <strong>Due Date:</strong>
                            <p style="color: @(Task.DueDate.Value < DateTime.Now ? "red" : "inherit")">
                                @Task.DueDate.Value.ToString("MMM dd, yyyy")
                                @if (Task.DueDate.Value < DateTime.Now)
                                {
                                    <span style="color:red;"> (Overdue)</span>
                                }
                            </p>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <RadzenButton Text="Delete Task" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@ConfirmDelete" />
                        <div>
                            <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Secondary" Click="@Close" Style="margin-right:8px;" />
                            <RadzenButton Text="Edit" Icon="edit" Click="@StartEdit" />
                        </div>
                    </div>
                }
            </RadzenFieldset>
        </RadzenTabsItem>

        <!-- Comments Tab -->
        <RadzenTabsItem Text="Comments">
            <RadzenFieldset Style="padding:16px; height:100%;">
                <h4>Comments</h4>

                <div class="mb-3">
                    <RadzenTextArea @bind-Value="newCommentContent" Placeholder="Write a comment..." Rows="3" Style="width:100%" Change="@(args => OnCommentContentChanged(args))" />
                    <RadzenButton Text="Add Comment" Icon="send" Click="@AddComment" ButtonStyle="ButtonStyle.Primary" Style="margin-top:8px;"
                                  Disabled="@string.IsNullOrWhiteSpace(newCommentContent?.Trim())" />
                </div>

                <hr />

                @if (isLoadingComments)
                {
                    <RadzenProgressBar Mode="@ProgressBarMode.Indeterminate" />
                }
                else if (!comments.Any())
                {
                    <p class="text-muted" style="text-align:center; padding:2rem;">No comments yet. Be the first to comment!</p>
                }
                else
                {
                    <div style="max-height:350px; overflow-y:auto;">
                        @foreach (var comment in comments.OrderBy(c => c.CreatedAt))
                        {
                            <RadzenCard Style="margin-bottom:1rem;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div style="flex:1;">
                                        <strong>@comment.UserEmail</strong>
                                        <small class="text-muted" style="margin-left:8px;">
                                            @comment.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                        </small>
                                        <p style="margin-top:8px;">@comment.Content</p>
                                    </div>
                                    @if (CanDeleteComment(comment))
                                    {
                                        <RadzenButton Size="ButtonSize.ExtraSmall" Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Click="@(() => ConfirmDeleteComment(comment))"
                                                      title="Delete comment" />
                                    }
                                </div>
                            </RadzenCard>
                        }
                    </div>
                }
            </RadzenFieldset>
        </RadzenTabsItem>

        <!-- Attachments Tab -->
        <RadzenTabsItem Text="Attachments">
            <RadzenFieldset Style="padding:16px; height:100%;">
                <h4>Attachments</h4>

                <!-- Upload Section -->
                <div class="mb-3">
                    <InputFile OnChange="@HandleFileSelected" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.jpg,.jpeg,.png,.gif,.zip,.rar" />
                    @if (selectedFile != null)
                    {
                        <div style="margin-top:8px;">
                            <span>Selected: @selectedFile.Name (@FormatFileSize(selectedFile.Size))</span>
                            <RadzenButton Text="Upload" Icon="upload" Click="@UploadAttachment"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Style="margin-left:8px;" Disabled="@isUploadingFile" />
                            <RadzenButton Text="Cancel" Icon="close" Click="@ClearFileSelection"
                                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Style="margin-left:4px;" Disabled="@isUploadingFile" />
                        </div>
                    }
                    @if (isUploadingFile)
                    {
                        <RadzenProgressBar Mode="@ProgressBarMode.Indeterminate" Style="margin-top:8px;" />
                    }
                </div>

                <hr />

                <!-- Attachments List -->
                @if (isLoadingAttachments)
                {
                    <RadzenProgressBar Mode="@ProgressBarMode.Indeterminate" />
                }
                else if (!attachments.Any())
                {
                    <p class="text-muted" style="text-align:center; padding:2rem;">No attachments yet. Upload files to get started!</p>
                }
                else
                {
                    <div style="max-height:350px; overflow-y:auto;">
                        @foreach (var attachment in attachments.OrderByDescending(a => a.UploadedAt))
                        {
                            <RadzenCard Style="margin-bottom:1rem;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div style="flex:1;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <RadzenIcon Icon="@GetFileIcon(attachment.ContentType)" Style="color:#666;" />
                                            <strong>@attachment.OriginalFileName</strong>
                                        </div>
                                        <small class="text-muted">
                                            @FormatFileSize(attachment.FileSize) •
                                            Uploaded by @attachment.UserEmail •
                                            @attachment.UploadedAt.ToString("MMM dd, yyyy hh:mm tt")
                                        </small>
                                    </div>
                                    <div style="display:flex; gap:4px;">
                                        <RadzenButton Size="ButtonSize.ExtraSmall" Icon="download"
                                                      ButtonStyle="ButtonStyle.Info"
                                                      Click="@(() => DownloadAttachment(attachment))"
                                                      title="Download" />
                                        @if (CanDeleteAttachment(attachment))
                                        {
                                            <RadzenButton Size="ButtonSize.ExtraSmall" Icon="delete"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Click="@(() => ConfirmDeleteAttachment(attachment))"
                                                          title="Delete" />
                                        }
                                    </div>
                                </div>
                            </RadzenCard>
                        }
                    </div>
                }
            </RadzenFieldset>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>