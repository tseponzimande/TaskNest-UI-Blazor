<EditForm Model="model" OnValidSubmit="@Submit">

    <RadzenFieldset Style="padding:16px;">
        <h4>Edit Board</h4>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <RadzenTextBox @bind-Value="model.Name" Placeholder="Name" Style="width:100%" />
            @if (showNameError)
            {
                <div class="text-danger">Name is required</div>
            }
            <br />
            <br />
            <div class="mb-3">
                <label class="form-label">Description</label>
                <RadzenTextBox @bind-Value="@model.Description" Placeholder="Description" Style="width:100%" />
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="Cancel" Style="margin-right:8px" />
            <br />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" />
        </div>

    </RadzenFieldset>

</EditForm>