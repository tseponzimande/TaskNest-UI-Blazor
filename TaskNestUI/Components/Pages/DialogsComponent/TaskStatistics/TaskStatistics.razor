<div class="row" style="margin-bottom:1rem;">
    <div class="col-md-3">
        <RadzenCard Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <div style="text-align:center;">
                <RadzenIcon Icon="task" Style="font-size:2rem;" />
                <h3 style="margin:0.5rem 0 0 0;">@TotalTasks</h3>
                <small>Total Tasks</small>
            </div>
        </RadzenCard>
    </div>

    <div class="col-md-3">
        <RadzenCard Style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
            <div style="text-align:center;">
                <RadzenIcon Icon="schedule" Style="font-size:2rem;" />
                <h3 style="margin:0.5rem 0 0 0;">@OverdueTasks</h3>
                <small>Overdue</small>
            </div>
        </RadzenCard>
    </div>

    <div class="col-md-3">
        <RadzenCard Style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
            <div style="text-align:center;">
                <RadzenIcon Icon="today" Style="font-size:2rem;" />
                <h3 style="margin:0.5rem 0 0 0;">@DueSoonTasks</h3>
                <small>Due This Week</small>
            </div>
        </RadzenCard>
    </div>

    <div class="col-md-3">
        <RadzenCard Style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
            <div style="text-align:center;">
                <RadzenIcon Icon="check_circle" Style="font-size:2rem;" />
                <h3 style="margin:0.5rem 0 0 0;">@CompletedTasks</h3>
                <small>Completed</small>
            </div>
        </RadzenCard>
    </div>
</div>