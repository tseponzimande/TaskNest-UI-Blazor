@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Admin Dashboard</PageTitle>

@if (isLoading)
{
    <RadzenProgressBar Mode="@ProgressBarMode.Indeterminate" />
}
else
{
    <div class="row">
        <div class="col-md-12 mb-3">
            <h3>Admin Dashboard</h3>
            <p class="text-muted">System-wide overview and management</p>
        </div>
    </div>

    <!-- Admin Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <RadzenCard Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; height:140px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h2 style="margin:0;">@stats.TotalUsers</h2>
                        <p style="margin:0; opacity:0.9;">Total Users</p>
                    </div>
                    <RadzenIcon Icon="people" Style="font-size:3rem; opacity:0.7;" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3">
            <RadzenCard Style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; height:140px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h2 style="margin:0;">@stats.TotalBoards</h2>
                        <p style="margin:0; opacity:0.9;">Total Boards</p>
                    </div>
                    <RadzenIcon Icon="view_module" Style="font-size:3rem; opacity:0.7;" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3">
            <RadzenCard Style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; height:140px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h2 style="margin:0;">@stats.TotalTasks</h2>
                        <p style="margin:0; opacity:0.9;">Total Tasks</p>
                    </div>
                    <RadzenIcon Icon="task" Style="font-size:3rem; opacity:0.7;" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3">
            <RadzenCard Style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; height:140px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h2 style="margin:0;">@stats.ActiveBoards</h2>
                        <p style="margin:0; opacity:0.9;">Active Boards</p>
                    </div>
                    <RadzenIcon Icon="trending_up" Style="font-size:3rem; opacity:0.7;" />
                </div>
            </RadzenCard>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-12">
            <RadzenCard>
                <h5>Quick Admin Actions</h5>
                <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:1rem;">
                    <RadzenButton Text="Manage Users" Icon="people" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => _navigationManager.NavigateTo("/admin/users"))" />
                    <RadzenButton Text="View All Boards" Icon="view_module" ButtonStyle="ButtonStyle.Info"
                                  Click="@(() => _navigationManager.NavigateTo("/boards"))" />
                    <RadzenButton Text="System Reports" Icon="assessment" ButtonStyle="ButtonStyle.Success"
                                  Click="@(() => _navigationManager.NavigateTo("/admin/reports"))" />
                    <RadzenButton Text="Refresh Data" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                  Click="@LoadDashboardData" />
                </div>
            </RadzenCard>
        </div>
    </div>

    <!-- Charts similar to regular dashboard -->
    <div class="row mb-4">
        <div class="col-md-6">
            <RadzenCard>
                <h5>System-wide Task Distribution</h5>
                @if (tasksByStatus.Any())
                {
                    <RadzenChart>
                        <RadzenPieSeries Data="@tasksByStatus" Title="Status" CategoryProperty="Status" ValueProperty="Count">
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenPieSeries>
                    </RadzenChart>
                }
            </RadzenCard>
        </div>

        <div class="col-md-6">
            <RadzenCard>
                <h5>Recent System Activity</h5>
                @if (recentActivity.Any())
                {
                    <div style="max-height:350px; overflow-y:auto;">
                        @foreach (var activity in recentActivity.Take(8))
                        {
                            <div style="padding:10px; border-bottom:1px solid #eee;">
                                <strong>@activity.Action</strong>
                                <p style="margin:0; color:#666;">@activity.Description</p>
                                <small style="color:#999;">@activity.UserEmail • @GetRelativeTime(activity.Timestamp)</small>
                            </div>
                        }
                    </div>
                }
            </RadzenCard>
        </div>
    </div>
}