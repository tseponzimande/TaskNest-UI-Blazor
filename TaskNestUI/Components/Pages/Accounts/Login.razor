@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div style="min-height:80vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(180deg,#f8fafc,#ffffff); padding:20px;">
    <RadzenCard Style="width:100%; max-width:560px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); border-radius:16px; overflow:hidden;">
        <div style="display:flex; gap:24px; align-items:center; padding:24px 24px 0 24px;">
            <div style="flex:0 0 64px; height:64px; display:flex; align-items:center; justify-content:center; background:#eef2ff; border-radius:12px;">
                <RadzenIcon Icon="task" Style="font-size:32px; color:#4f46e5;" />
            </div>
            <div style="flex:1;">
                <h2 style="margin:0;">Welcome to TaskNest</h2>
                <p class="text-muted" style="margin:4px 0 0 0;">Sign in to continue to your workspace</p>
            </div>
        </div>

        <div style="padding:24px;">
            <RadzenTemplateForm Data="@loginModel" Submit="@(async (DTOs.LoginDto model) => await UserLogin(model))">
                <div class="mb-3">
                    <RadzenLabel Text="Email" />
                    <RadzenTextBox @bind-Value="loginModel.Email" Placeholder="you@example.com" Style="width:100%; height: 4rem; border-radius: 2rem;" />
                </div>

                <div class="mb-3">
                    <RadzenLabel Text="Password" />
                    <RadzenPassword @bind-Value="loginModel.Password" Placeholder="••••••••" Style="width:100%; height: 4rem; border-radius: 2rem;" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-muted" style="font-size:0.9rem;">Use the credentials you registered with</div>
                    <RadzenLink Path="/register" Text="Create account" />
                </div>

                <RadzenButton ButtonType="ButtonType.Submit" Text="Sign In" Disabled="@isLoading"
                              Icon="login" ButtonStyle="ButtonStyle.Primary" Style="width:100%; height: 5rem; border-radius: 4rem;" />
            </RadzenTemplateForm>
        </div>

        <div style="padding:16px; background:#f8fafc; text-align:center; color:#64748b;">
            By continuing you agree to our terms and privacy policy.
        </div>
    </RadzenCard>
</div>