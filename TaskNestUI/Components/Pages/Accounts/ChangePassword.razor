@page "/change-password"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<RadzenCard>
    <h3>Change Password</h3>
    <RadzenTemplateForm Data="@changeModel" Submit="@(async(DTOs.ChangePasswordDto model)=> await OnChangePassword(model))">
        <RadzenFieldset>
            <br />
            <br />
            <RadzenPassword @bind-Value="changeModel.CurrentPassword" Placeholder="Old Password" Style="width: 50%;" />
            <br />
            <br />
            <RadzenPassword @bind-Value="changeModel.NewPassword" Placeholder="New Password" Style="width: 50%;" />
            <br />
            <br />
            <RadzenPassword @bind-Value="changeModel.ConfirmNewPassword" Placeholder="Confirm Password" Style="width: 50%;" />
            <br />
            <br />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Change Password" />
        </RadzenFieldset>
    </RadzenTemplateForm>
</RadzenCard>