@using TaskNestUI.Components.Pages.NotificationBell
@inherits LayoutComponentBase


<RadzenComponents @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@ToggleSidebar" Style="margin-right: 1rem;" />

            <RadzenHeading Size="HeadingSize.H5" Text="TaskNestUI" />

            <div style="margin-left:auto; margin-right: 1rem; display:flex; align-items:center; gap:1rem;">
                @if (isAuthenticated)
                {
                    <NotificationBell />
                }
            </div>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded" Style="width: 250px;">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>